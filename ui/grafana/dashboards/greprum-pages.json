{
  "uid": "greprum-pages",
  "title": "GrepRUM / Pages",
  "tags": [
    "greprum",
    "pages"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "mysql",
          "uid": "greprum-greptime"
        },
        "query": "SELECT DISTINCT site_id FROM visitor_hours",
        "refresh": 2,
        "includeAll": false,
        "current": {},
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Which page gets the most clicks?",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "greprum-greptime"
      },
      "description": "Top pages by click count (rollup).",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "greprum-greptime"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT `path` AS page, sum(click_count) AS clicks FROM click_stats_1h WHERE site_id = '${site}' AND $__timeFilter(time_window) GROUP BY `path` ORDER BY clicks DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Page views and visitors",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "greprum-greptime"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "greprum-greptime"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT `path` AS page, count(*) AS page_views, count(DISTINCT visitor_id) AS visitors FROM events WHERE site_id = '${site}' AND event_name = '$pageview' AND $__timeFilter(ts) GROUP BY `path` ORDER BY page_views DESC LIMIT 50"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Entry pages",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "greprum-greptime"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "greprum-greptime"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT `path` AS page, sum(sessions) AS sessions, sum(CASE WHEN is_new_visitor THEN sessions ELSE 0 END) AS new_visitors FROM session_starts_1h WHERE site_id = '${site}' AND $__timeFilter(time_window) GROUP BY `path` ORDER BY sessions DESC LIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "annotations": {
    "list": []
  }
}
