{
  "uid": "greprum-session-detail",
  "title": "GrepRUM / Session detail",
  "tags": [
    "greprum",
    "sessions"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "mysql",
          "uid": "greprum-greptime"
        },
        "query": "SELECT DISTINCT site_id FROM visitor_hours",
        "refresh": 2,
        "includeAll": false,
        "current": {},
        "sort": 1
      },
      {
        "name": "session_id",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "mysql",
          "uid": "greprum-greptime"
        },
        "query": "SELECT session_id FROM (SELECT session_id, max(ts) AS last_ts FROM events WHERE site_id = '${site}' AND $__timeFilter(ts) GROUP BY session_id ORDER BY last_ts DESC LIMIT 200) t ORDER BY last_ts DESC",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {},
        "sort": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "What did one visitor do, in order?",
      "type": "table",
      "datasource": {
        "type": "mysql",
        "uid": "greprum-greptime"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 18
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "greprum-greptime"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ts AS time, seq, event_name, `path` AS page, el_css AS element, el_text AS text, props FROM events WHERE site_id = '${site}' AND session_id = '${session_id}' AND $__timeFilter(ts) ORDER BY ts, seq LIMIT 1000"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ],
  "annotations": {
    "list": []
  }
}
