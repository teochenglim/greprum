      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "greprum-greptime"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT browser AS metric, count(DISTINCT visitor_id) AS visitors FROM events WHERE site_id = '${site}' AND $__timeFilter(ts) AND event_name = '$session_start' GROUP BY browser ORDER BY visitors DESC LIMIT 15"
