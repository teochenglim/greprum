{
  "uid": "greprum-usage",
  "title": "GrepRUM / Usage",
  "tags": [
    "greprum",
    "usage"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "site",
        "label": "Site",
        "type": "query",
        "datasource": {
          "type": "mysql",
          "uid": "greprum-greptime"
        },
        "query": "SELECT DISTINCT site_id FROM visitor_hours",
        "refresh": 2,
        "includeAll": false,
        "current": {},
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Events per day (stored)",
      "type": "timeseries",
      "datasource": {
        "type": "mysql",
        "uid": "greprum-greptime"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "greprum-greptime"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT date_bin('1 day'::INTERVAL, ts) AS time, count(*) AS events FROM events WHERE site_id = '${site}' AND $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Accepted, rejected, dropped (gateway)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "greprum-prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "greprum-prometheus"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "sum by (kind) (increase(greprum_site_events_total{site=\"${site}\"}[1d]))"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "Spool fill and age of oldest unwritten event",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "greprum-prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "greprum-prometheus"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "greprum_oldest_unwritten_event_age_ms / 1000"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "Shed and dropped by reason",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "greprum-prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "greprum-prometheus"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
